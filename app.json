{
  "expo": {
    "name": "ubeApp",
    "slug": "ubeApp",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/splash-icon.png",
    "scheme": "ubeapp",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.company.ubeapp",
      "googleServicesFile": "./GoogleService-Info.plist",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSCameraUsageDescription": "Camera access is required to capture document images for identity verification.",
        "NSPhotoLibraryUsageDescription": "Photo library access is required to upload document images for identity verification.",
        "NSLocationWhenInUseUsageDescription": "Location access is used to detect your country for identity verification."
      }
    },
    "android": {
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.ubeapp",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-build-properties",
        {
          "android": {
            "buildArchs": [
              "arm64-v8a",
              "armeabi-v7a"
            ]
          }
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow $(PRODUCT_NAME) to access your camera for identity verification.",
          "microphonePermission": "Allow $(PRODUCT_NAME) to access your microphone for identity verification.",
          "recordAudioAndroid": true
        }
      ],
      "./plugins/withModularHeaders",
      [
        "@react-native-firebase/app",
        {
          "ios": {
            "disableSPM": true
          }
        }
      ],
      [
        "@didit-protocol/sdk-react-native",
        {
          "iosNfcEnabled": false,
          "androidNfcEnabled": false,
          "androidVariant": "autodetection"
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#6C63FF",
          "defaultChannel": "chat"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "5899c8a4-d469-4730-a6ae-4f7080d545ca"
      }
    }
  }
}
